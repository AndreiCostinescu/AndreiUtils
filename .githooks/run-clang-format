#!/usr/bin/env sh
# .githooks/run-clang-format
#
# Formats staged C/C++ files in place with clang-format, using the
# repository's .clang-format style. If any file is reformatted, pre-commit
# aborts the commit so you can review the changes and re-stage them.
#
# Called by pre-commit — do not invoke directly.

if ! command -v clang-format >/dev/null 2>&1; then
    echo "ERROR: clang-format not found on PATH. Install LLVM/clang-format and try again."
    exit 1
fi

STAGED_CPP_FILES=$(git diff --cached --name-only --diff-filter=AM | grep -E '\.(h|hpp|hh|hxx|c|cc|cpp|cxx)$')

if [ -z "$STAGED_CPP_FILES" ]; then
    exit 0
fi

# shellcheck disable=SC2086
clang-format -i $STAGED_CPP_FILES

# clang-format gives no output of its own, so determine which of the staged
# files it actually changed by diffing the (now reformatted) working tree
# against what's staged in the index. Files clang-format left alone will
# show no diff here.
CHANGED_FILES=""
for f in $STAGED_CPP_FILES; do
    if ! git diff --quiet -- "$f"; then
        CHANGED_FILES="$CHANGED_FILES $f"
    fi
done

if [ -n "$CHANGED_FILES" ]; then
    echo "clang-format reformatted the following file(s):"
    for f in $CHANGED_FILES; do
        echo "  - $f"
    done
    echo ""
    echo "--- diff (working tree vs. what you staged) ---"
    # shellcheck disable=SC2086
    git --no-pager diff -- $CHANGED_FILES
    echo "------------------------------------------------"
fi

#!/usr/bin/env sh
# .githooks/commit-msg
#
# Rejects commits that lack a "Signed-off-by:" trailer.
#
# Invoked by the pre-commit framework as the `dco-check` hook's entry point
# (see .pre-commit-config.yaml, stage: commit-msg) — not meant to be run
# directly or installed via core.hooksPath. Run `make setup` once to wire it
# up via `pre-commit install --hook-type commit-msg`.

COMMIT_MSG_FILE="$1"

if ! grep -qE "^Signed-off-by: .+ <.+@.+>" "$COMMIT_MSG_FILE"; then
    echo ""
    echo "ERROR: Commit rejected — missing 'Signed-off-by' trailer."
    echo ""
    echo "Every commit must include a DCO sign-off.  Use:"
    echo ""
    echo "    git commit -s -m \"your message\""
    echo ""
    echo "This adds the following line to your commit message automatically:"
    echo ""
    echo "    Signed-off-by: Your Name <you@example.com>"
    echo ""
    echo "Make sure your git user.name and user.email are configured:"
    echo ""
    echo "    git config --global user.name  \"Your Name\""
    echo "    git config --global user.email \"you@example.com\""
    echo ""
    exit 1
fi
